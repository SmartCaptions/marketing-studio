{
  "compilerOptions": {
    "target": "ES2018",
    "module": "commonjs",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": [
      "es2017"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@kit": [
        "src/finish/kit.tsx"
      ],
      "@work/*": [
        "src/finish/example/src/*"
      ]
    }
  },
  "exclude": [
    "remotion.config.ts"
  ]
}
